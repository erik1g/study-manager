# Study Manager: the settings of one installation. Copy to .env and fill in, or let
# infra/scripts/setup.mjs write one with fresh secrets (see the admin documentation).
# Never commit your .env; it holds the keys to your data.

# --- Where the app is reached --------------------------------------------------
# The public address of your installation, without a trailing slash. TLS ends at your reverse proxy.
DOMAIN=study.example.org
SITE_URL=https://study.example.org
# Where browsers and MCP clients reach the sign-in service; also the issuer of the tokens.
API_EXTERNAL_URL=https://study.example.org/auth/v1

# The person who sets up the first admin account: its link is printed in the server log on the first start.
ADMIN_EMAIL=you@example.org

# --- Secrets (generate with infra/scripts/setup.mjs; never reuse these) ------------
POSTGRES_PASSWORD=change-me
POSTGRES_DB=postgres
POSTGRES_PORT=5432
JWT_SECRET=change-me-at-least-32-characters-long
JWT_EXPIRY=900
JWT_KEYS='[]'
ANON_KEY=change-me
SERVICE_ROLE_KEY=change-me
# Encrypts what the app stores for users, such as their API keys.
APP_SECRET=change-me-at-least-32-characters-long
# Encrypts the nightly backups. Without it no backups are made. Keep a copy elsewhere:
# the backups cannot be read without it.
BACKUP_PASSPHRASE=change-me-at-least-16-characters

# --- Behaviour ------------------------------------------------------------------
# Tasks and the calendar are planned in this time zone.
TZ=Europe/Berlin
# Log level of the server: debug, info, warn, error.
LOG_LEVEL=warn

# --- Where it listens -------------------------------------------------------------
# The web container's port on this machine. Your reverse proxy points to it.
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
# Addresses or ranges of your reverse proxy that may tell who the visitor is
# (comma separated, or the default private_ranges for private networks).
TRUSTED_PROXIES=private_ranges

# --- Storage (optional) -------------------------------------------------------------
# Without these Docker keeps uploads/backups and the database in named volumes.
# With a path the folder on the host is used (owned by the user with id 1000 for DATA_DIR).
# DATA_DIR=/srv/study-manager/data
# DB_DIR=/srv/study-manager/db

# --- Mail (optional) ------------------------------------------------------------------
# Without it the admin hands out invitation and recovery links by hand.
# SMTP_HOST=smtp.example.org
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# --- Images (optional) ------------------------------------------------------------------
# Which version to run: latest, or a version such as 1.2.3 (recommended).
# STUDY_VERSION=latest
# STUDY_IMAGE_PREFIX=docker.io/erik1g
